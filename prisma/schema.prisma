generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           String       @default("Viewer") // Owner, Admin, Support Agent, Viewer
  signature      String?      // per-user reply sign-off; falls back to org Settings.closing when unset
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastLogin      DateTime?
  lastSeenAt     DateTime?    // refreshed on every authenticated request -- "active" is derived from this, not a separate stored flag
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  users        User[]
  inboxes      Inbox[]
  emails       Email[]
  rules        Rule[]
  documents    Document[]
  templates    Template[]
  integrations Integration[]
  customers    Customer[]
  internalNotes InternalNote[]
  aiReplyCaches AIReplyCache[]
  b2bSenders   B2BSender[]
  settings     Settings?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Customer {
  id             String       @id @default(uuid())
  email          String
  name           String?
  totalEmails    Int          @default(0)
  totalReplies   Int          @default(0)
  lastEmailAt    DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emails         Email[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
}

model Settings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  systemPrompt   String       @default("You are a helpful customer support agent...")
  tone           String       @default("Professional") // Friendly, Formal, Sales, Technical, Support
  greeting       String       @default("Hello,")
  closing        String       @default("Regards,\nSupport Team")
  autoReplyMode  String       @default("DRAFT") // AUTO (Fully Automatic), DRAFT (AI Draft -> Human Approval), MANUAL (Manual Only)
  confidenceThreshold Float @default(0.8)
}

// Caches an AI-generated reply by a hash of (subject + first-100-words-of-body)
// so the exact same email content is never sent to OpenAI twice.
model AIReplyCache {
  id             String       @id @default(uuid())
  organizationId String
  contentHash    String
  replyText      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, contentHash])
}

model Inbox {
  id             String       @id @default(uuid())
  name           String
  emailAddress   String       @unique
  provider       String       // GMAIL, OUTLOOK, IMAP
  credentials    String       // Encrypted OAuth tokens or connection settings
  status         String       @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Email {
  id              String       @id @default(uuid())
  externalId      String?      // Provider email ID
  gmailThreadId   String?      // Gmail thread ID, for grouping a conversation
  gmailCategory   String       @default("primary") // primary, updates (Gmail Promotions/Social/Forums/bulk mail bucketed together)
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sender          String
  recipient       String
  cc              String?      // comma-separated CC'd addresses from the original inbound message
  subject         String
  body            String
  preview         String
  attachments     String       @default("[]") // JSON array of { filename, contentType, size, dataUrl } -- images/PDFs/docs from the original message, capped per-file and per-email at sync time
  status          String       @default("UNREAD") // UNREAD, WAITING, REPLIED, ESCALATED, SPAM -- a workflow state, not "has anyone opened this"
  isRead          Boolean      @default(false) // set true the first time an agent opens this email; drives bold/thin in the inbox list, independent of the workflow status above
  priority        String       @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  sentiment       String       @default("NEUTRAL") // POSITIVE, NEUTRAL, NEGATIVE, ANGRY
  category        String       @default("General Inquiry") // Sales, Support, Billing, Refund, Complaint, Technical, HR, etc.
  businessType    String       @default("B2C") // B2C or B2B, heuristic-classified from content
  language        String       @default("en")
  aiConfidence    Float        @default(0.0)
  spam            Boolean      @default(false)
  duplicate       Boolean      @default(false)
  urgency         String       @default("MEDIUM") // LOW, MEDIUM, HIGH
  summary         String?      // AI-generated brief summary
  matchedTemplateId String?    // AI-matched template ID
  aiProvider      String?      // "Keyword Matcher" (template match, no API call) or "OpenAI (<model>)" / "OpenAI (cached)"
  userFeedback    String?      // Correct Template, Wrong Template, Better Template Exists, etc.
  userFeedbackNotes String?    // user notes / added keywords
  assignedUserId  String?
  assignedAt      DateTime?
  lockedByUserId  String?      // support agent currently viewing/working this email; prevents collision
  lockedAt        DateTime?
  lastActionByUserId String?
  lastActionAt    DateTime?
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  autoReplies     AutoReply[]
  failedMatches   FailedMatch[]
  internalNotes   InternalNote[]
  assignmentLogs  AssignmentLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model AutoReply {
  id                String    @id @default(uuid())
  emailId           String
  email             Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  status            String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, SENT, REJECTED
  responseBody      String
  originalDraftBody String?   // the AI-generated text before any human edits
  wasEdited         Boolean   @default(false)
  editedBy          String?   // email of the last person who edited this draft
  editedAt          DateTime?
  tone              String?   // tone used for the most recent AI regeneration, e.g. "Friendly"
  sentAt            DateTime?
  approvedBy        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Rule {
  id             String       @id @default(uuid())
  name           String
  conditions     String       // Serialized JSON containing: category, priority, sentiment, keywords, etc.
  actions        String       // Serialized JSON containing: auto_reply, template_id, assign_to, escalate, status
  active         Boolean      @default(true)
  triggerCount   Int          @default(0)
  lastTriggeredAt DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Document {
  id             String       @id @default(uuid())
  title          String
  content        String
  fileType       String       // PDF, DOCX, TXT, MD
  fileSize       Int
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Template {
  id             String       @id @default(uuid())
  name           String
  subject        String
  body           String
  variables      String       // Comma separated list of variables like: {{customer_name}}, {{ticket_id}}
  keywords       String       @default("{}") // JSON: { primary, secondary, product, problem, intent, negative: string[] }
  images         String       @default("[]") // JSON array of { id, dataUrl } -- referenced in body via {{image_<id>}} tokens
  active         Boolean      @default(true)
  notes          String?      // Admin internal notes
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Integration {
  id             String       @id @default(uuid())
  type           String       // SLACK, TEAMS, DISCORD, WEBHOOK
  config         String       // Serialized JSON credentials / webhook URLs
  active         Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AuditLog {
  id             String    @id @default(uuid())
  action         String
  userId         String?
  userEmail      String?   // denormalized for easy display without a join
  entityType     String?   // email, template, keyword, note, rule
  entityId       String?
  beforeValue    String?
  afterValue     String?
  ipAddress      String?
  details        String
  createdAt      DateTime  @default(now())
}

model FailedMatch {
  id                    String    @id @default(uuid())
  emailId               String
  email                 Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  userId                String?
  userEmail             String?
  aiSelectedTemplateId  String?
  correctedTemplateId   String?
  confidenceScore       Float     @default(0)
  matchedKeywords       String?
  aiReason              String?
  status                String    @default("Open") // Open, Reviewed, Resolved
  notes                 String?
  createdAt             DateTime  @default(now())
  reviewedAt            DateTime?
}

model InternalNote {
  id                  String       @id @default(uuid())
  title               String
  body                String
  relatedTemplateId   String?
  relatedEmailId      String?
  relatedEmail        Email?       @relation(fields: [relatedEmailId], references: [id], onDelete: SetNull)
  createdByUserId     String?
  createdByName       String?
  updatedByUserId     String?
  updatedByName       String?
  isPinned            Boolean      @default(false)
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

// Admin-managed allow-list replacing the old keyword-based B2C/B2B heuristic
// (which produced a false positive matching "ein" inside ordinary words).
// `value` is matched against either the full sender address or its domain.
model B2BSender {
  id             String       @id @default(uuid())
  value          String       // an email address (e.g. "buyer@wholesale.com") or a bare domain (e.g. "wholesale.com")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, value])
}

model AssignmentLog {
  id                 String   @id @default(uuid())
  emailId            String
  email              Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  assignedToUserId   String
  assignedToName     String?
  assignedBy         String?  // "round_robin" or the admin's email for manual reassignment
  assignmentMethod   String   @default("round_robin") // round_robin, manual
  createdAt          DateTime @default(now())
}

model LearningLog {
  id               String   @id @default(uuid())
  emailId          String?
  subject          String?
  sender           String?
  emailText        String
  aiSelectedTmpl   String?
  userApprovedTmpl String?
  rejectedTmpl     String?
  keywordsAdded    String?
  confidenceScore  Float
  finalResponse    String
  feedbackClicked  String?
  createdAt        DateTime @default(now())
}
