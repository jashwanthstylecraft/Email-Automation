# =========================================================================
# AI Email Automation & Auto-Reply Web Application - Environment Variables
# =========================================================================

# Database Configuration
# This app runs on Postgres (works locally via Docker, or a free hosted DB like Neon/Supabase for deployment)
DATABASE_URL="postgresql://username:password@localhost:5432/email_db?schema=public"

# Scheduled Inbox Sync (Vercel Cron / external cron pinger)
# Protects GET /api/cron/sync from unauthenticated calls. Leave unset locally.
CRON_SECRET="generate-a-random-string-for-this"

# AI Provider Credentials
# Single provider: OpenAI (gpt-3.5-turbo). If left blank, template matches
# still work (keyword-based, free); only the "no template matched" fallback
# reply generation is skipped.
OPENAI_API_KEY=your_openai_api_key_here

# Integrations (Optional)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Next.js Port Config (Production)
PORT=3000
HOST=0.0.0.0


# 📥 Reading Incoming Mails (IMAP Configuration)
IMAP_USER="your-business-email@gmail.com"    # Your business email address
IMAP_PASSWORD="your-app-password"            # App password (e.g. from Gmail settings)
IMAP_HOST="imap.gmail.com"                   # Server host (e.g. imap.gmail.com or outlook.office365.com)
IMAP_PORT=993                                # 993 is the secure default port

# 📤 Sending Auto-Replies (SMTP Configuration)
SMTP_USER="your-business-email@gmail.com"    # Usually same as above
SMTP_PASSWORD="your-app-password"            # Usually same as above
SMTP_HOST="smtp.gmail.com"                   # Server host (e.g. smtp.gmail.com or smtp.office365.com)
SMTP_PORT=465                                # 465 or 587 is the secure default port
